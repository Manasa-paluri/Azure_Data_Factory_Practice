			"properties": {
				"activities": [
					{
						"name": "Copy_data_api_dataset",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"path": "$['id']"
										},
										"sink": {
											"path": "id"
										}
									},
									{
										"source": {
											"path": "$['name']"
										},
										"sink": {
											"path": "name"
										}
									},
									{
										"source": {
											"path": "$['username']"
										},
										"sink": {
											"path": "username"
										}
									},
									{
										"source": {
											"path": "$['email']"
										},
										"sink": {
											"path": "mail"
										}
									},
									{
										"source": {
											"path": "$['phone']"
										},
										"sink": {
											"path": "phone"
										}
									},
									{
										"source": {
											"path": "$['website']"
										},
										"sink": {
											"path": "website"
										}
									}
								]
							}
						},
						"inputs": [
							{
								"referenceName": "api_json",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_api_csv_blob",
								"type": "DatasetReference",
								"parameters": {
									"input_json_csv": "input_json_api"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
